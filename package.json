{
  "name": "bfx",
  "version": "1.0.0",
  "description": "minimal brainfuck toolchain written in typescript",
  "keywords": [
    "brainfuck",
    "bytecode",
    "cli",
    "compiler",
    "interpreter"
  ],
  "license": "MIT",
  "bin": {
    "bfx": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts --no-dts && tsc --noEmit false --declaration --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^24.3.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.93.0",
    "tsdown": "^0.15.1",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
